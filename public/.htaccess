# Pionniers de Touraine : pionniersdetouraine.fr (o2switch, site racine full code).
# Ce fichier est ignore par GitHub Pages (demo) et actif sur Apache/o2switch.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> sans www, puis HTTPS force (une seule adresse publique)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----- Redirections 301 de l'ancien WordPress (bascule 08/2026) -----
  # Boutique et e-commerce -> sous-domaine shop (chemins conserves)
  RewriteRule ^boutique(/.*)?$ https://shop.pionniersdetouraine.fr/boutique$1 [R=301,L]
  RewriteRule ^produit/(.*)$ https://shop.pionniersdetouraine.fr/produit/$1 [R=301,L]
  RewriteRule ^panier(/.*)?$ https://shop.pionniersdetouraine.fr/panier$1 [R=301,L]
  RewriteRule ^commander(/.*)?$ https://shop.pionniersdetouraine.fr/commander$1 [R=301,L]
  RewriteRule ^mon-compte(/.*)?$ https://shop.pionniersdetouraine.fr/mon-compte$1 [R=301,L]
  RewriteRule ^livraison-et-retours(/.*)?$ https://shop.pionniersdetouraine.fr/livraison-et-retours$1 [R=301,L]
  RewriteRule ^cgv(/.*)?$ https://shop.pionniersdetouraine.fr/cgv$1 [R=301,L]

  # Pages club de l'ancien site -> nouvelles pages
  RewriteRule ^sponsors(/.*)?$ /partenaires/ [R=301,L]
  RewriteRule ^nous-contacter(/.*)?$ /contact/ [R=301,L]
  # NE : sans ce flag, Apache reencode le # en %23 et la cible tombe en 404.
  RewriteRule ^adhesions(/.*)?$ https://recrutement.pionniersdetouraine.fr/#adhesions [R=301,L,NE]
  RewriteRule ^infos-pratiques(/.*)?$ / [R=301,L]
  RewriteRule ^cookies(/.*)?$ /politique-de-confidentialite/ [R=301,L]
  RewriteRule ^politique-de-cookies-ue(/.*)?$ /politique-de-confidentialite/ [R=301,L]
  RewriteRule ^page-d-exemple(/.*)?$ / [R=301,L]

  # ----- Redirections 301 de l'ancien site 2011-2015 (URL encore liees depuis des forums) -----
  RewriteRule ^club/ /le-club/ [R=301,L]
  RewriteRule ^equipes/ /nos-sections/ [R=301,L]
  RewriteRule ^regles/ /blog/regles-football-americain/ [R=301,L]
  # Uniquement les anciens fichiers .html sous contact/ : la page actuelle
  # /contact/ est un dossier servi par son index.html et n'est pas capturee.
  RewriteRule ^contact/[^/]+\.html$ /contact/ [R=301,L]
  RewriteRule ^accueil\.html$ / [R=301,L]
  RewriteRule ^medias/ / [R=301,L]
  RewriteRule ^calendriers_resultats/ https://calendrier.pionniersdetouraine.fr/ [R=301,L]
</IfModule>

# Page 404 generee par le build Next
ErrorDocument 404 /404.html

# Le module d'envoi n'est jamais appele directement
<Files "_mailer.php">
  Require all denied
</Files>

# Cache : CSS/JS Next (noms haches) et polices en longue duree,
# images en 7 jours (fichiers remplacables sous le meme nom), HTML revalide a
# chaque visite (max-age=0 + ETag : reponse 304 si rien n'a change).
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|otf|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ----- En-tetes de securite -----
  # HSTS volontairement court (300 s) pour un premier deploiement : a passer a
  # 31536000 avec includeSubDomains une fois les sous-domaines verifies
  # (shop, recrutement, calendrier) tous joignables en HTTPS.
  # La CSP reste en Report-Only : on observe d'abord les violations, on passera
  # a Content-Security-Policy une fois les rapports propres.
  # img-src https: couvre les tuiles OpenStreetMap de la carte sur /contact/.
  Header always set Strict-Transport-Security "max-age=300"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://*.goatcounter.com; frame-ancestors 'self'"
</IfModule>

# Validation du cache HTML : ETag sur date de modification et taille.
FileETag MTime Size

# UTF-8 par defaut
AddDefaultCharset UTF-8
