# Pionniers de Touraine : pionniersdetouraine.fr (o2switch, site racine full code).
# Ce fichier est ignore par GitHub Pages (demo) et actif sur Apache/o2switch.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> sans www, puis HTTPS force (une seule adresse publique)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----- Redirections 301 de l'ancien WordPress (bascule 08/2026) -----
  # Boutique et e-commerce -> sous-domaine shop (chemins conserves)
  RewriteRule ^boutique(/.*)?$ https://shop.pionniersdetouraine.fr/boutique$1 [R=301,L]
  RewriteRule ^produit/(.*)$ https://shop.pionniersdetouraine.fr/produit/$1 [R=301,L]
  RewriteRule ^panier(/.*)?$ https://shop.pionniersdetouraine.fr/panier$1 [R=301,L]
  RewriteRule ^commander(/.*)?$ https://shop.pionniersdetouraine.fr/commander$1 [R=301,L]
  RewriteRule ^mon-compte(/.*)?$ https://shop.pionniersdetouraine.fr/mon-compte$1 [R=301,L]
  RewriteRule ^livraison-et-retours(/.*)?$ https://shop.pionniersdetouraine.fr/livraison-et-retours$1 [R=301,L]
  RewriteRule ^cgv(/.*)?$ https://shop.pionniersdetouraine.fr/cgv$1 [R=301,L]

  # Pages club de l'ancien site -> nouvelles pages
  RewriteRule ^sponsors(/.*)?$ /partenaires/ [R=301,L]
  RewriteRule ^nous-contacter(/.*)?$ /contact/ [R=301,L]
  RewriteRule ^adhesions(/.*)?$ https://recrutement.pionniersdetouraine.fr/#adhesions [R=301,L]
  RewriteRule ^infos-pratiques(/.*)?$ / [R=301,L]
  RewriteRule ^cookies(/.*)?$ /politique-de-confidentialite/ [R=301,L]
  RewriteRule ^politique-de-cookies-ue(/.*)?$ /politique-de-confidentialite/ [R=301,L]
  RewriteRule ^page-d-exemple(/.*)?$ / [R=301,L]
</IfModule>

# Page 404 generee par le build Next
ErrorDocument 404 /404.html

# Le module d'envoi n'est jamais appele directement
<Files "_mailer.php">
  Require all denied
</Files>

# Cache : CSS/JS Next (noms haches) et polices en longue duree,
# images en 7 jours (fichiers remplacables sous le meme nom), HTML jamais.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|otf|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# UTF-8 par defaut
AddDefaultCharset UTF-8
